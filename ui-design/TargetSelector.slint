// components/TargetSelector.slint - 目标迁移盘选择器
import { Theme } from "../appwindow.slint";

export component TargetSelector inherits Rectangle {
    in property <string> current-drive: "D:";
    in property <string> free-space: "";

    pure callback drive-changed(string);

    background: Theme.bg-card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border-color;

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        Text {
            text: "目标迁移盘";
            color: Theme.text-secondary;
            font-size: 13px;
            font-weight: 600;
        }

        // 下拉选择框 (简化版)
        Rectangle {
            height: 40px;
            background: Theme.bg-primary;
            border-radius: 8px;
            border-width: 2px;
            border-color: Theme.info;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                Text {
                    text: root.current-drive + " 数据盘 (1.5 TB)";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 500;
                    vertical-alignment: center;
                }

                Text {
                    text: "▼";
                    color: Theme.info;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                // 实际使用时弹出下拉菜单
                clicked => { root.drive-changed("D:"); }
            }
        }

        Text {
            text: "可用空间: " + root.free-space + " | NTFS格式";
            color: Theme.text-muted;
            font-size: 11px;
        }
    }
}
