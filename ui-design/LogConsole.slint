// components/LogConsole.slint - 操作日志面板
import { Theme, LogEntry } from "../appwindow.slint";

export component LogConsole inherits Rectangle {
    in property <[LogEntry]> entries: [];

    background: Theme.bg-card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border-color;

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        Text {
            text: "操作日志";
            color: Theme.text-secondary;
            font-size: 13px;
            font-weight: 600;
        }

        ScrollView {
            height: parent.height - 50px;

            VerticalLayout {
                spacing: 6px;

                for entry in root.entries: HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "[" + entry.timestamp + "]";
                        color: Theme.text-muted;
                        font-size: 10px;
                        width: 70px;
                    }

                    Text {
                        text: entry.message;
                        color: root.log-color(entry.level);
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    pure function log-color(level: string) -> color {
        if level == "success" { return Theme.success; }
        if level == "warn" { return Theme.warning; }
        if level == "error" { return Theme.danger; }
        if level == "info" { return Theme.info; }
        return Theme.text-primary;
    }
}
