// components/DiskOverview.slint - C盘空间概览
import { Theme } from "../appwindow.slint";

export component DiskOverview inherits Rectangle {
    in property <float> used-percent: 0.0;
    in property <string> total: "";
    in property <string> free: "";

    background: Theme.bg-card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border-color;

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        Text {
            text: "C盘空间概览";
            color: Theme.text-secondary;
            font-size: 13px;
            font-weight: 600;
        }

        // 环形图
        Rectangle {
            height: 140px;

            // 背景圆环
            Path {
                commands: "M 80 20 A 60 60 0 1 1 79.99 20";
                stroke: Theme.bg-primary;
                stroke-width: 12px;
                fill: none;
            }

            // 进度圆环
            Path {
                commands: root.arc-commands();
                stroke: root.ring-color();
                stroke-width: 12px;
                fill: none;
                stroke-line-cap: round;
            }

            Text {
                x: 80px; y: 55px;
                text: round(root.used-percent * 100) + "%";
                color: Theme.text-primary;
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                x: 80px; y: 75px;
                text: "已使用";
                color: Theme.text-muted;
                font-size: 11px;
                horizontal-alignment: center;
            }
        }

        // 空间详情
        HorizontalLayout {
            spacing: 16px;

            VerticalLayout {
                spacing: 4px;

                Text {
                    text: "总容量: " + root.total;
                    color: Theme.text-muted;
                    font-size: 12px;
                }

                Text {
                    text: "可用: " + root.free;
                    color: Theme.text-muted;
                    font-size: 12px;
                }
            }

            Text {
                text: root.used-percent > 0.8 ? "⚠️ 空间紧张" : "✓ 空间充足";
                color: root.used-percent > 0.8 ? Theme.danger : Theme.success;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }

    pure function ring-color() -> color {
        if root.used-percent > 0.9 { return Theme.danger; }
        if root.used-percent > 0.7 { return Theme.warning; }
        return Theme.success;
    }

    // 简化的圆弧路径 (Slint Path 需要简化)
    pure function arc-commands() -> string {
        // 返回部分圆弧路径，实际使用时可能需要更精确的计算
        return "M 80 20 A 60 60 0 " + (root.used-percent > 0.5 ? "1" : "0") + " 1 " + root.arc-end-x() + " " + root.arc-end-y();
    }

    pure function arc-end-x() -> float {
        return 80 + 60 * sin(root.used-percent * 2 * 3.14159);
    }

    pure function arc-end-y() -> float {
        return 80 - 60 * cos(root.used-percent * 2 * 3.14159);
    }
}
