// components/JournalBar.slint - 底部事务日志状态栏
import { Theme } from "../global.slint";

export component JournalBar inherits Rectangle {
    in property <string> stage: "空闲";
    in property <bool> has-pending: false;

    pure callback rollback-clicked();

    background: Theme.bg-card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border-color;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        alignment: space-between;
        vertical-stretch: 1;

        VerticalLayout {
            alignment: center;

            Text {
                text: "事务日志 (Journal)";
                color: Theme.text-secondary;
                font-size: 13px;
                font-weight: 600;
            }

            Text {
                text: "pending_jobs.json | 状态: " + root.stage;
                color: Theme.text-muted;
                font-size: 11px;
            }
        }

        // 回滚按钮
        Rectangle {
            width: 100px;
            height: 32px;
            background: root.has-pending ? Theme.danger-bg : Theme.bg-hover;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.has-pending ? Theme.danger : Theme.border-color;

            Text {
                text: "⚠️ 紧急回滚";
                color: root.has-pending ? Theme.danger : Theme.text-muted;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                enabled: root.has-pending;
                clicked => { root.rollback-clicked(); }
            }
        }
    }
}
