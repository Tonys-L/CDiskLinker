// components/DiskOverview.slint - C盘空间概览
import { Theme } from "../global.slint";

export component DiskOverview inherits Rectangle {
    in property <float> used-percent: 0.0;
    in property <string> total: "";
    in property <string> free: "";

    background: Theme.bg-card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border-color;

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        Text {
            text: "C盘空间概览";
            color: Theme.text-secondary;
            font-size: 13px;
            font-weight: 600;
        }

        // 大百分比数值居中展示
        Rectangle {
            height: 120px;
            background: Theme.bg-primary;
            border-radius: 8px;

            VerticalLayout {
                alignment: center;
                spacing: 4px;

                Text {
                    text: Math.round(root.used-percent * 100) + "%";
                    color: root.used-percent > 0.9 ? Theme.danger : (root.used-percent > 0.7 ? Theme.warning : Theme.success);
                    font-size: 36px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }

                Text {
                    text: "已使用";
                    color: Theme.text-muted;
                    font-size: 11px;
                    horizontal-alignment: center;
                }
            }
        }

        // 空间占用条
        Rectangle {
            height: 8px;
            background: Theme.bg-primary;
            border-radius: 4px;

            Rectangle {
                width: parent.width * root.used-percent;
                height: parent.height;
                background: root.used-percent > 0.9 ? Theme.danger : (root.used-percent > 0.7 ? Theme.warning : Theme.success);
                border-radius: 4px;
            }
        }

        // 空间详情
        HorizontalLayout {
            spacing: 16px;

            VerticalLayout {
                spacing: 4px;

                Text {
                    text: "总容量: " + root.total;
                    color: Theme.text-muted;
                    font-size: 12px;
                }

                Text {
                    text: "可用: " + root.free;
                    color: Theme.text-muted;
                    font-size: 12px;
                }
            }

            Text {
                text: root.used-percent > 0.8 ? "⚠️ 空间紧张" : "✓ 空间充足";
                color: root.used-percent > 0.8 ? Theme.danger : Theme.success;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}
