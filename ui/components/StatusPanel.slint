// components/StatusPanel.slint - 实时迁移状态面板
import { Theme, MigrationStatus } from "../global.slint";

// === 状态节点组件（必须定义在 StatusPanel 之前） ===
component StatusNode inherits HorizontalLayout {
    in property <string> label: "";
    in property <int> status: 0;
    in property <MigrationStatus> current: MigrationStatus.Idle;

    height: 28px;
    spacing: 12px;
    alignment: start;

    // 状态映射到数值
    pure function status-value() -> int {
        if current == MigrationStatus.Idle { return -1; }
        if current == MigrationStatus.Scanning { return 0; }
        if current == MigrationStatus.Initiated { return 1; }
        if current == MigrationStatus.Copying { return 2; }
        if current == MigrationStatus.Validating { return 3; }
        if current == MigrationStatus.Linking { return 4; }
        if current == MigrationStatus.Completed { return 5; }
        return -1;
    }

    pure function node-color() -> color {
        if root.status-value() > root.status { return Theme.success; }
        if root.status-value() == root.status { return Theme.info; }
        return Theme.border-color;
    }

    pure function text-color() -> color {
        if root.status-value() >= root.status { return Theme.text-primary; }
        return Theme.text-muted;
    }

    pure function is-active() -> bool {
        return root.status-value() == root.status;
    }

    Rectangle {
        width: 16px; height: 16px;
        background: root.node-color();
        border-radius: 8px;

        if root.is-active(): Rectangle {
            width: 8px; height: 8px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #ffffff;
            border-radius: 4px;
        }
    }

    Text {
        text: root.label;
        color: root.text-color();
        font-size: 11px;
        font-weight: root.is-active() ? 600 : 400;
        vertical-alignment: center;
    }
}

// === 主面板组件 ===
export component StatusPanel inherits Rectangle {
    in property <MigrationStatus> current-status: MigrationStatus.Idle;
    in property <float> progress-percent: 0.0;
    in property <string> progress-detail: "";

    background: Theme.bg-card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border-color;

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        Text {
            text: "实时迁移状态";
            color: Theme.text-secondary;
            font-size: 13px;
            font-weight: 600;
        }

        // 状态机可视化
        Rectangle {
            height: 200px;
            background: Theme.bg-primary;
            border-radius: 8px;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                StatusNode { label: "提权完成"; status: 0; current: root.current-status; }
                StatusNode { label: "扫描完成"; status: 1; current: root.current-status; }
                StatusNode { label: "正在拷贝..."; status: 2; current: root.current-status; }
                StatusNode { label: "数据校验"; status: 3; current: root.current-status; }
                StatusNode { label: "建立联接"; status: 4; current: root.current-status; }
            }
        }

        // 进度条
        Text {
            text: "当前进度";
            color: Theme.text-secondary;
            font-size: 11px;
        }

        Rectangle {
            height: 8px;
            background: Theme.bg-primary;
            border-radius: 4px;

            Rectangle {
                width: parent.width * root.progress-percent;
                height: parent.height;
                background: Theme.info;
                border-radius: 4px;
            }
        }

        Text {
            text: "进度: " + Math.round(root.progress-percent * 100) + "%";
            color: Theme.info;
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: right;
        }

        if root.progress-detail != "": Text {
            text: root.progress-detail;
            color: Theme.text-muted;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}
